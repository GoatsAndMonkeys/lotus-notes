      "song_key": null,
      "src": 3,
      "text": "Reviewer got a pit ticket; Jim James roamed the whole stage, and the Riverside felt small and intimate",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 3,
      "text": "The show ended with a double encore totaling four songs",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 3,
      "text": "Reviews published the day after the show were reportedly all enthusiastic",
      "type": "scene"
     },
     {
      "recording": "MMJ2011-06-16.MK4",
      "song": null,
      "song_key": null,
      "src": 1,
      "text": "Recorded with DFC gear and a FOB clamped to the second balcony rail, extended three feet",
      "type": "lineage"
     },
     {
      "recording": "MMJ2011-06-16.MK4",
      "song": null,
      "song_key": null,
      "src": 1,
      "text": "Short-lived crackling from the PA system is marked in the recording",
      "type": "sound"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 1,
      "text": "Daniel Martin Moore is credited on vocals; Carl Broemel played electric guitar, pedal steel and saxophone, and Bo Koster keyboards and percussion",
      "type": "scene"
     }
