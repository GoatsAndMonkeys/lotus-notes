      "type": "scene"
     },
     {
      "recording": "gd1970-11-13.179403.sbd.cassidy.minches.miller.t.flac1648",
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "The tape is horribly degraded and ragged; Charlie Miller's restoration made it listenable enough to hear the show",
      "type": "sound"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "Jamming on R&B material was a late-1970 emphasis, heard in the Not Fade Away and Goin' Down the Road sandwich, Midnight Hour and Good Lovin'",
      "type": "compare"
     },
     {
      "recording": "gd1970-11-13.179403.sbd.cassidy.minches.miller.t.flac1648",
      "song": null,
      "song_key": null,
      "src": 1,
      "text": "Sound is unlistenable until the middle of Casey Jones, with heavy tape bleed-through; making it listenable took a lot of work",
      "type": "sound"
     },
     {
      "recording": "gd1970-11-13.179403.sbd.cassidy.minches.miller.t.flac1648",
      "song": null,
      "song_key": null,
      "src": 1,
      "text": "Tapes came from Martin Cassidy; tape flips occur in Midnight Hour and Drums",
      "type": "lineage"
     },
     {
      "recording": null,
      "song": "In The Midnight Hour",
      "song_key": "song:grateful-dead:in-the-midnight-hour",
      "src": 1,
      "text": "Contains a Saint Stephen jam",
      "type": "song"
     }
    ],
