   "facts": {
    "claims": [
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 3,
      "text": "Reviewer also taped the show on a cheap mono Panasonic recorder; that tape has long been lost",
      "type": "scene"
     },
     {
      "recording": null,
      "song": "Me And My Uncle",
      "song_key": "song:grateful-dead:me-and-my-uncle",
      "src": 3,
      "text": "Reviewer insists the actual set opened with Cold Rain and Snow; the archive recording begins a few notes into this song",
      "type": "song"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "Show was oversold and counterfeit tickets circulated beforehand; doors opened only fifteen minutes before showtime, causing a stampede by people without tickets",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "Venue eventually regained control and stopped admitting people, leaving Pat Small, Amy Kirkland and friends locked out",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 7,
      "text": "Attendee, at his first Dead show, says the performance was not cut short and still owns a poster",
      "type": "scene"
     },
     {
      "recording": "gd71-03-21.aud.cotsman.12074.sbeok.shnf",
      "song": null,
      "song_key": null,
      "src": 7,
      "text": "Recording derives from a bootleg LP the reviewer bought at Brady & Farwell in Milwaukee",
      "type": "lineage"
     },
     {
      "recording": "gd71-03-21.aud.cotsman.12074.sbeok.shnf",
      "song": null,
      "song_key": null,
      "src": 2,
      "text": "Fairly decent audience recording for its era, with minor vinyl crackles audible because a bootleg LP is in the lineage",
      "type": "sound"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 2,
      "text": "Deadlists says the band played only one short set because they had to catch a plane",
      "type": "scene"
     },
     {
      "recording": null,
      "song": "Not Fade Away",
      "song_key": "song:grateful-dead:not-fade-away",
      "src": 2,
      "text": "Not Fade Away goes into Goin' Down The Road Feelin' Bad and returns to Not Fade Away, then We Bid You Good Night",
      "type": "song"
     }
    ],
