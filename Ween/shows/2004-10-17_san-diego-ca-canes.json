     },
     {
      "recording": "Ween2004-10-17",
      "song": null,
      "song_key": null,
      "src": 3,
      "text": "Reviewer finds the recording good but not the best, rating it four out of five",
      "type": "sound"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 3,
      "text": "The encore ran about seventeen minutes, and the reviewer enjoyed it",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "Reviewer met Gener outside the venue before the show, then watched from the rail",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "While fist-pumping at the rail, reviewer was grabbed and accidentally punched a woman in the face",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "Reviewer remembers the show as long and hot",
      "type": "scene"
     }
