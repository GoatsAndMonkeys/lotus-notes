   "facts": {
    "claims": [
     {
      "recording": "ween2018-10-17.CMC44-2448",
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "Recorded from an upstairs seat off center at the Ryman; Captain Fireball uploaded and labeled it for the taper's account",
      "type": "lineage"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "The taper had made a well-regarded audience tape of the Shit Creek Boys at the Fillmore in 1996",
      "type": "compare"
     },
     {
      "recording": "Ween2018-10-17.MK012aud",
      "song": null,
      "song_key": null,
      "src": 1,
      "text": "Taped and transferred by Zachariah Boes using Oktava MK-012-01 cardioid mics into a Fostex FR2-LE at 24-bit/48k",
      "type": "lineage"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 1,
      "text": "A drunk woman stood on her seat for the second half of one song, booing, calling it insensitive and flipping off the band",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 1,
      "text": "The whole show was played with Bobby Ogdin and the Shit Creek Boys",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 3,
      "text": "The show was billed as Ween and the Shit Creek Boys",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 3,
      "text": "This was the second night; a separate recording of the first night, October 16, is also on the Archive",
      "type": "compare"
     }
    ],
