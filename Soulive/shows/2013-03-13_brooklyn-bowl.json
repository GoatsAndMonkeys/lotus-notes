   "facts": {
    "claims": [
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 1,
      "text": "Show was Night 5 of Bowlive IV, with The London Souls opening",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 1,
      "text": "Shady Horns joined: Ryan Zoidis, James Casey and Eric Bloom, all adding percussion alongside their horns",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 1,
      "text": "Marco Benevento sat in on Fender Rhodes; David Hidalgo played guitar; the whole London Souls band also joined",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 2,
      "text": "Part of Bowlive IV, Night 5, opened by The London Souls",
      "type": "scene"
     },
     {
      "recording": null,
      "song": null,
      "song_key": null,
      "src": 2,
      "text": "Guests included Shady Horns, Marco Benevento on Rhodes, David Hidalgo on guitar, and the full London Souls band",
      "type": "scene"
     },
     {
      "recording": "soulive2013-03-13.mk21.flac16",
      "song": null,
      "song_key": null,
      "src": 2,
      "text": "A four-microphone on-stage mix also exists, adding a split pair of Schoeps mk5 omnis placed ten feet apart",
      "type": "lineage"
     },
     {
      "recording": "soulive2013-03-13.mk21-cmc65omnimix.flac16",
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "Main pair: Schoeps mk21 cardioids, NOS, on stage, through KC-5 capsules, Sonosax preamp, into Sound Devices 744T at 24/96",
      "type": "lineage"
     },
     {
      "recording": "soulive2013-03-13.mk21-cmc65omnimix.flac16",
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "Second source: Schoeps cmc65 omnis split ten feet, via Lunatec ACM V3 into the 744T; mixed in Vegas Pro",
      "type": "lineage"
     },
     {
      "recording": "soulive2013-03-13.mk21-cmc65omnimix.flac16",
      "song": null,
      "song_key": null,
      "src": 4,
      "text": "Mix was normalized and faded in SoundForge, resampled to 44.1 kHz with iZotope, dithered to 16 bit, then encoded to FLAC",
      "type": "lineage"
     }
    ],
    "format": "liner-3",
